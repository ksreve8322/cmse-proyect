@using cmse.Repositories.Models
@model Equipo

@{
    ViewData["Title"] = "Eliminar equipo";
}

<div class="container py-5">

    <div class="card shadow-sm mx-auto" style="max-width: 650px;">

        <div class="card-header bg-danger text-white text-center">
            <h4 class="mb-0">Eliminar equipo</h4>
        </div>

        <div class="card-body text-center p-4">

            <div class="mb-3">
                <span style="font-size: 55px; color: #dc3545;">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </span>
            </div>

            <h5 class="fw-bold mb-3">
                ¿Estás seguro de eliminar este equipo?
            </h5>

            <p class="text-muted">
                Esta acción no se puede deshacer.
            </p>

            <div class="text-start bg-light rounded p-3 mb-4">

                <p class="mb-2">
                    <strong>Nombre:</strong> @Model.Nombre
                </p>

                <p class="mb-2">
                    <strong>Tipo:</strong> @Model.IdTipoEquipoNavigation?.Nombre
                </p>

                <p class="mb-2">
                    <strong>Marca:</strong> @(Model.Marca ?? "No especificada")
                </p>

                <p class="mb-2">
                    <strong>Modelo:</strong> @(Model.Modelo ?? "No especificado")
                </p>

                <p class="mb-0">
                    <strong>Número de serie:</strong>
                    @(Model.NumeroSerie ?? "No especificado")
                </p>

            </div>

            <form asp-controller="Equipo"
                  asp-action="ConfirmarEliminar"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.IdEquipo" />

                <div class="d-flex justify-content-center gap-3">

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-danger">
                        Eliminar equipo
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>
