@model cmse.Repositories.Models.Mantenimiento

@{
    ViewData["Title"] = "Registrar mantenimiento";

    var repuestos = ViewBag.RepuestosTemporales as IEnumerable<cmse.Controllers.MantenimientoController.RepuestoTemporal>
        ?? Enumerable.Empty<cmse.Controllers.MantenimientoController.RepuestoTemporal>();
}

<div class="cmse-container">
    <h2>Registrar mantenimiento</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["Error"]
        </div>
    }

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success" role="status">
            @TempData["Exito"]
        </div>
    }

    <div class="cmse-form-section">
        <h3>Información de la incidencia</h3>

        <div class="cmse-form-group">
            <label for="idIncidencia">ID de incidencia</label>
            <input type="text"
                   id="idIncidencia"
                   value="@Model.IdIncidencia"
                   aria-label="ID de incidencia"
                   readonly />
        </div>
    </div>

    <div class="cmse-form-section">
        <h3>Información del equipo</h3>

        <div class="cmse-form-group">
            <label for="nombreEquipo">Equipo</label>
            <input type="text"
                   id="nombreEquipo"
                   value="@Model.IdEquipoNavigation.Nombre"
                   aria-label="Nombre del equipo"
                   readonly />
        </div>

        <div class="cmse-form-group">
            <label for="tipoEquipo">Tipo</label>
            <input type="text"
                   id="tipoEquipo"
                   value="@Model.IdEquipoNavigation.IdTipoEquipoNavigation.Nombre"
                   aria-label="Tipo de equipo"
                   readonly />
        </div>

        <div class="cmse-form-group">
            <label for="modeloEquipo">Modelo</label>
            <input type="text"
                   id="modeloEquipo"
                   value="@Model.IdEquipoNavigation.Modelo"
                   aria-label="Modelo del equipo"
                   readonly />
        </div>

        <div class="cmse-form-group">
            <label for="numeroSerie">Número de serie</label>
            <input type="text"
                   id="numeroSerie"
                   value="@Model.IdEquipoNavigation.NumeroSerie"
                   aria-label="Número de serie del equipo"
                   readonly />
        </div>
    </div>

    <div class="cmse-form-section">
        <h3>Mantenimiento</h3>

        <div class="cmse-form-group">
            <label for="fechaProgramada">Fecha programada</label>
            <input type="text"
                   id="fechaProgramada"
                   value="@Model.FechaProgramada.ToString("dd/MM/yyyy HH:mm")"
                   aria-label="Fecha programada del mantenimiento"
                   readonly />
        </div>
    </div>

    <div class="cmse-form-section">
        <h3>Repuestos utilizados</h3>

        @if (repuestos.Any())
        {
            <div style="overflow-x: auto;">
                <table class="table table-bordered table-striped">
                    <caption class="visually-hidden">Listado de repuestos utilizados en el mantenimiento</caption>
                    <thead>
                        <tr>
                            <th scope="col">Nombre</th>
                            <th scope="col">Código</th>
                            <th scope="col">Cantidad</th>
                            <th scope="col">Valor unitario</th>
                            <th scope="col">Valor total</th>
                            <th scope="col">Fecha de instalación</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var repuesto in repuestos)
                        {
                            <tr>
                                <td>@repuesto.Nombre</td>
                                <td>@repuesto.Codigo</td>
                                <td>@repuesto.Cantidad</td>
                                <td>@repuesto.ValorUnitario.ToString("C")</td>
                                <td>@((repuesto.Cantidad * repuesto.ValorUnitario).ToString("C"))</td>
                                <td>@repuesto.FechaInstalacion.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p>No has agregado repuestos a este mantenimiento.</p>
        }

        <div style="display: flex; width: 100%; margin-top: 15px;">
            <a asp-action="RegistrarRepuestos"
               asp-route-id="@Model.IdMantenimiento"
               class="cmse-mantenimiento-boton"
               style="width: 180px; text-align: center; text-decoration: none; box-sizing: border-box; margin-left: auto;">
                Registrar repuestos
            </a>
        </div>
    </div>

    <form asp-action="RegistrarMantenimiento" method="post" novalidate>
        @Html.AntiForgeryToken()

        <input type="hidden" name="idMantenimiento" value="@Model.IdMantenimiento" />

        <div class="cmse-form-section">
            <h3>Resultado del mantenimiento</h3>

            <div class="cmse-form-group">
                <label for="actividades">Actividades realizadas y observaciones *</label>
                <textarea id="actividades"
                          name="actividades"
                          rows="6"
                          required
                          aria-required="true"
                          placeholder="Describe las actividades realizadas y las observaciones...">@Html.Raw(System.Net.WebUtility.HtmlEncode(ViewData.ModelState["actividades"]?.AttemptedValue))</textarea>

                @Html.ValidationMessage("actividades", "", new { @class = "text-danger" })
            </div>

            <div class="cmse-form-group">
                <label for="resultado">Resultado del mantenimiento *</label>
                <select id="resultado" name="resultado" required aria-required="true">
                    <option value="">Seleccione el resultado</option>
                    <option value="Satisfactorio" selected="@(ViewData.ModelState["resultado"]?.AttemptedValue == "Satisfactorio")">Satisfactorio</option>
                    <option value="Con observaciones" selected="@(ViewData.ModelState["resultado"]?.AttemptedValue == "Con observaciones")">Con observaciones</option>
                    <option value="Requiere seguimiento" selected="@(ViewData.ModelState["resultado"]?.AttemptedValue == "Requiere seguimiento")">Requiere seguimiento</option>
                </select>

                @Html.ValidationMessage("resultado", "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="cmse-form-actions"
             style="display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 12px; width: 100%; margin-top: 25px;">

            <button type="submit"
                    class="cmse-mantenimiento-boton"
                    style="width: 150px; text-align: center;">
                Registrar
            </button>

            <a asp-action="ConsultarAsignaciones"
               class="cmse-mantenimiento-cancelar"
               style="width: 150px; box-sizing: border-box; text-align: center; display: flex; justify-content: center; align-items: center; text-decoration: none;">
                Cancelar
            </a>
        </div>
    </form>
</div>
