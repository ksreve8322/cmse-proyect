@model cmse.Repositories.Models.Mantenimiento

@{
    ViewData["Title"] = "Registrar repuestos";
}

<div class="container">
    <h2 class="text-center mb-4">Registrar repuestos utilizados</h2>

    <form asp-action="AgregarRepuestoTemporal" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" name="idMantenimiento" value="@Model.IdMantenimiento" />

        <h4>Información del equipo</h4>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Equipo</label>
                <input class="form-control"
                       value="@Model.IdEquipoNavigation.Nombre"
                       readonly />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Tipo</label>
                <input class="form-control"
                       value="@Model.IdEquipoNavigation.IdTipoEquipoNavigation.Nombre"
                       readonly />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Modelo</label>
                <input class="form-control"
                       value="@Model.IdEquipoNavigation.Modelo"
                       readonly />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Número de serie</label>
                <input class="form-control"
                       value="@Model.IdEquipoNavigation.NumeroSerie"
                       readonly />
            </div>
        </div>

        <hr />

        <h4>Información del repuesto</h4>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Nombre</label>
                <input type="text" name="nombre" class="form-control"
                       required maxlength="100" />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Código</label>
                <input type="text" name="codigo" class="form-control"
                       required maxlength="50" />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Marca</label>
                <input type="text" name="marca" class="form-control"
                       maxlength="100" />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Modelo</label>
                <input type="text" name="modelo" class="form-control"
                       maxlength="100" />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Número de serie</label>
                <input type="text" name="numeroSerie" class="form-control"
                       maxlength="100" />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Cantidad</label>
                <input type="number" name="cantidad" id="cantidad"
                       class="form-control" min="1" value="1" required />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Valor unitario</label>
                <input type="number" name="valorUnitario" id="valorUnitario"
                       class="form-control" min="0.01" step="0.01" required />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Valor total</label>
                <input type="number" id="valorTotal"
                       class="form-control" readonly />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Fecha de instalación</label>
                <input type="date" name="fechaInstalacion"
                       class="form-control" required />
            </div>

            <div class="col-12 mb-3">
                <label class="form-label">Observaciones</label>
                <textarea name="observaciones" class="form-control"
                          rows="3" maxlength="500"></textarea>
            </div>
        </div>

        <div class="d-flex justify-content-center gap-3 mt-4">
            <button type="submit" class="btn btn-primary px-4">
                Agregar repuesto
            </button>

            <a asp-action="RegistrarMantenimiento"
               asp-route-id="@Model.IdIncidencia"
               class="btn btn-secondary px-4">
                Volver
            </a>
        </div>
    </form>
</div>

<script>
    const cantidad = document.getElementById("cantidad");
    const valorUnitario = document.getElementById("valorUnitario");
    const valorTotal = document.getElementById("valorTotal");

    function calcularTotal() {
        const c = Number(cantidad.value) || 0;
        const v = Number(valorUnitario.value) || 0;

        valorTotal.value = (c * v).toFixed(2);
    }

    cantidad.addEventListener("input", calcularTotal);
    valorUnitario.addEventListener("input", calcularTotal);
</script>
