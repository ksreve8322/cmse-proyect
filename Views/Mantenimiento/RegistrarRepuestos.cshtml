@model cmse.Repositories.Models.Mantenimiento

@{
    ViewData["Title"] = "Registrar repuestos";
}

<div class="container">
    <h2 class="text-center mb-4">Registrar repuestos utilizados</h2>

    <form asp-action="AgregarRepuestoTemporal" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" name="idMantenimiento" value="@Model.IdMantenimiento" />

        <h4>Información del equipo</h4>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label for="nombreEquipo" class="form-label">Equipo</label>
                <input type="text"
                       id="nombreEquipo"
                       class="form-control"
                       value="@Model.IdEquipoNavigation.Nombre"
                       aria-label="Nombre del equipo"
                       readonly />
            </div>

            <div class="col-md-6 mb-3">
                <label for="tipoEquipo" class="form-label">Tipo</label>
                <input type="text"
                       id="tipoEquipo"
                       class="form-control"
                       value="@Model.IdEquipoNavigation.IdTipoEquipoNavigation.Nombre"
                       aria-label="Tipo de equipo"
                       readonly />
            </div>

            <div class="col-md-6 mb-3">
                <label for="modeloEquipo" class="form-label">Modelo</label>
                <input type="text"
                       id="modeloEquipo"
                       class="form-control"
                       value="@Model.IdEquipoNavigation.Modelo"
                       aria-label="Modelo del equipo"
                       readonly />
            </div>

            <div class="col-md-6 mb-3">
                <label for="numeroSerieEquipo" class="form-label">Número de serie</label>
                <input type="text"
                       id="numeroSerieEquipo"
                       class="form-control"
                       value="@Model.IdEquipoNavigation.NumeroSerie"
                       aria-label="Número de serie del equipo"
                       readonly />
            </div>
        </div>

        <hr />

        <h4>Información del repuesto</h4>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label for="nombre" class="form-label">Nombre *</label>
                <input type="text"
                       id="nombre"
                       name="nombre"
                       class="form-control"
                       required
                       aria-required="true"
                       maxlength="100" />
            </div>

            <div class="col-md-6 mb-3">
                <label for="codigo" class="form-label">Código *</label>
                <input type="text"
                       id="codigo"
                       name="codigo"
                       class="form-control"
                       required
                       aria-required="true"
                       maxlength="50" />
            </div>

            <div class="col-md-6 mb-3">
                <label for="marca" class="form-label">Marca</label>
                <input type="text"
                       id="marca"
                       name="marca"
                       class="form-control"
                       maxlength="100" />
            </div>

            <div class="col-md-6 mb-3">
                <label for="modelo" class="form-label">Modelo</label>
                <input type="text"
                       id="modelo"
                       name="modelo"
                       class="form-control"
                       maxlength="100" />
            </div>

            <div class="col-md-6 mb-3">
                <label for="numeroSerie" class="form-label">Número de serie</label>
                <input type="text"
                       id="numeroSerie"
                       name="numeroSerie"
                       class="form-control"
                       maxlength="100" />
            </div>

            <div class="col-md-6 mb-3">
                <label for="cantidad" class="form-label">Cantidad *</label>
                <input type="number"
                       name="cantidad"
                       id="cantidad"
                       class="form-control"
                       min="1"
                       value="1"
                       required
                       aria-required="true" />
            </div>

            <div class="col-md-6 mb-3">
                <label for="valorUnitario" class="form-label">Valor unitario *</label>
                <input type="number"
                       name="valorUnitario"
                       id="valorUnitario"
                       class="form-control"
                       min="0.01"
                       step="0.01"
                       required
                       aria-required="true" />
            </div>

            <div class="col-md-6 mb-3">
                <label for="valorTotal" class="form-label">Valor total</label>
                <input type="number"
                       id="valorTotal"
                       class="form-control"
                       aria-label="Valor total calculado del repuesto"
                       readonly />
            </div>

            <div class="col-md-6 mb-3">
                <label for="fechaInstalacion" class="form-label">Fecha de instalación *</label>
                <input type="date"
                       id="fechaInstalacion"
                       name="fechaInstalacion"
                       class="form-control"
                       required
                       aria-required="true" />
            </div>

            <div class="col-12 mb-3">
                <label for="observaciones" class="form-label">Observaciones</label>
                <textarea id="observaciones"
                          name="observaciones"
                          class="form-control"
                          rows="3"
                          maxlength="500"></textarea>
            </div>
        </div>

        <div class="d-flex justify-content-center gap-3 mt-4">
            <button type="submit" class="btn btn-primary px-4">
                Agregar repuesto
            </button>

            <a asp-action="RegistrarMantenimiento"
               asp-route-id="@Model.IdIncidencia"
               class="btn btn-secondary px-4">
                Volver
            </a>
        </div>
    </form>
</div>

<script>
    const cantidad = document.getElementById("cantidad");
    const valorUnitario = document.getElementById("valorUnitario");
    const valorTotal = document.getElementById("valorTotal");

    function calcularTotal() {
        const c = Number(cantidad.value) || 0;
        const v = Number(valorUnitario.value) || 0;

        valorTotal.value = (c * v).toFixed(2);
    }

    cantidad.addEventListener("input", calcularTotal);
    valorUnitario.addEventListener("input", calcularTotal);
</script>
