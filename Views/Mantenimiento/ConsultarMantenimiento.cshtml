@model cmse.Repositories.Models.Mantenimiento

@{
    ViewData["Title"] = "Consultar mantenimiento";

    int? rolId = Context.Session.GetInt32("RolId");
    bool esAdministrador = rolId == 1;

    var fechaFinalizacionEstimada = Model.DuracionEstimadaHoras.HasValue
        ? Model.FechaProgramada.AddHours((double)Model.DuracionEstimadaHoras.Value)
        : (DateTime?)null;
}

<div class="container mt-4">

    <h2 class="text-center mb-4">Consultar mantenimiento</h2>

    <div class="d-flex justify-content-center flex-wrap gap-2 mb-4">

        @if (esAdministrador)
        {
            <a asp-controller="Mantenimiento"
               asp-action="Index"
               class="btn btn-primary">
                Asignar técnico
            </a>

            <a asp-controller="Mantenimiento"
               asp-action="ConsultarAsignaciones"
               class="btn btn-primary">
                Consultar incidencias asignadas
            </a>
        }

        <a asp-controller="Mantenimiento"
           asp-action="Consultar"
           class="btn btn-primary">
            Consultar mantenimientos
        </a>

        @if (esAdministrador)
        {
            <a asp-controller="Mantenimiento"
               asp-action="Programar"
               class="btn btn-primary">
                Programar mantenimiento
            </a>

            <a asp-controller="Mantenimiento"
               asp-action="Cancelar"
               class="btn btn-primary">
                Cancelar mantenimiento programado
            </a>
        }

    </div>

    <div class="card shadow-sm mx-auto" style="max-width: 900px;">

        <div class="card-header text-center">
            <h4 class="mb-0">Información del mantenimiento</h4>
        </div>

        <div class="card-body">

            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>ID del mantenimiento:</strong>
                    <p>@Model.IdMantenimiento</p>
                </div>

                <div class="col-md-6">
                    <strong>Estado:</strong>
                    <p>@Model.IdEstadoNavigation?.Nombre</p>
                </div>
            </div>

            <hr />

            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Equipo:</strong>
                    <p>@Model.IdEquipoNavigation?.Nombre</p>
                </div>

                <div class="col-md-6">
                    <strong>Código de inventario:</strong>
                    <p>@Model.IdEquipoNavigation?.CodigoInventario</p>
                </div>
            </div>

            <hr />

            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Técnico asignado:</strong>
                    <p>
                        @(Model.IdTecnicoNavigation != null
                            ? $"{Model.IdTecnicoNavigation.Nombres} {Model.IdTecnicoNavigation.Apellidos}"
                            : "No disponible")
                    </p>
                </div>

                <div class="col-md-6">
                    <strong>Tipo de mantenimiento:</strong>
                    <p>@Model.IdTipoMantenimientoNavigation?.Nombre</p>
                </div>
            </div>

            <hr />

            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Fecha y hora programada:</strong>
                    <p>@Model.FechaProgramada.ToString("dd/MM/yyyy HH:mm")</p>
                </div>

                <div class="col-md-6">
                    <strong>Duración estimada:</strong>
                    <p>
                        @(Model.DuracionEstimadaHoras.HasValue
                            ? $"{Model.DuracionEstimadaHoras.Value:F2} horas"
                            : "No definida")
                    </p>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Finalización estimada:</strong>
                    <p>
                        @(fechaFinalizacionEstimada.HasValue
                            ? fechaFinalizacionEstimada.Value.ToString("dd/MM/yyyy HH:mm")
                            : "No disponible")
                    </p>
                </div>

                <div class="col-md-6">
                    <strong>Fecha de realización:</strong>
                    <p>
                        @(Model.FechaRealizacion.HasValue
                            ? Model.FechaRealizacion.Value.ToString("dd/MM/yyyy HH:mm")
                            : "Pendiente")
                    </p>
                </div>
            </div>

            <hr />

            <div class="mb-3">
                <strong>Incidencia relacionada:</strong>
                <p>
                    @(Model.IdIncidencia.HasValue
                        ? Model.IdIncidencia.Value.ToString()
                        : "No está relacionado con una incidencia")
                </p>
            </div>

            <hr />

            <div class="mb-3">
                <strong>Descripción:</strong>
                <p>
                    @(string.IsNullOrWhiteSpace(Model.Descripcion)
                        ? "Sin descripción"
                        : Model.Descripcion)
                </p>
            </div>

            <div class="mb-3">
                <strong>Observaciones:</strong>
                <p>
                    @(string.IsNullOrWhiteSpace(Model.Observaciones)
                        ? "Sin observaciones"
                        : Model.Observaciones)
                </p>
            </div>

            <div class="mb-3">
                <strong>Resultado:</strong>
                <p>
                    @(string.IsNullOrWhiteSpace(Model.Resultado)
                        ? "Sin resultado registrado"
                        : Model.Resultado)
                </p>
            </div>

            <div class="mb-3">
                <strong>Motivo de cancelación:</strong>
                <p>
                    @(string.IsNullOrWhiteSpace(Model.MotivoCancelacion)
                        ? "No aplica"
                        : Model.MotivoCancelacion)
                </p>
            </div>

        </div>
    </div>

    @if (esAdministrador)
    {
        <div class="d-flex justify-content-center gap-3 mt-4 mb-4">

            <a asp-controller="Mantenimiento"
               asp-action="Consultar"
               class="btn btn-secondary">
                Regresar
            </a>

            <a asp-controller="Mantenimiento"
               asp-action="Programar"
               class="btn btn-primary">
                Programar mantenimiento
            </a>

        </div>
    }

</div>
