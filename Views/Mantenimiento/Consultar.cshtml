@model IEnumerable<cmse.Repositories.Models.Mantenimiento>

@{
    ViewData["Title"] = "Consultar mantenimientos";
}

<div class="cmse-mantenimiento-container">

    <div class="cmse-mantenimiento-header">
        <h2>Consultar mantenimientos</h2>
        <p>Consulta los mantenimientos programados y realizados de los equipos registrados.</p>
    </div>

    <div class="cmse-mantenimiento-barra-superior">

        <div class="cmse-mantenimiento-busqueda">
            <span class="cmse-mantenimiento-lupa">⌕</span>
            <input type="text"
                   id="buscarMantenimiento"
                   placeholder="Buscar mantenimiento..."
                   autocomplete="off" />
        </div>

        <div class="cmse-mantenimiento-acciones">

            <a asp-controller="Mantenimiento"
               asp-action="Index"
               class="cmse-mantenimiento-boton">
                Asignar técnico
            </a>

            <a asp-controller="Mantenimiento"
               asp-action="ConsultarAsignaciones"
               class="cmse-mantenimiento-boton">
                Consultar incidencias asignadas
            </a>

            <a asp-controller="Mantenimiento"
               asp-action="Consultar"
               class="cmse-mantenimiento-boton">
                Consultar mantenimientos
            </a>

            <a asp-controller="Mantenimiento"
               asp-action="Programar"
               class="cmse-mantenimiento-boton">
                Programar mantenimiento
            </a>

            <a asp-controller="Mantenimiento"
               asp-action="Cancelar"
               class="cmse-mantenimiento-boton">
                Cancelar mantenimiento programado
            </a>

        </div>

    </div>

    <div class="cmse-mantenimiento-listado-header">
        <h3>Listado de mantenimientos</h3>
        <p>Selecciona un mantenimiento para consultar su información.</p>
    </div>

    <div class="cmse-mantenimiento-tabla-contenedor">

        @if (Model != null && Model.Any())
        {
            <table class="cmse-mantenimiento-tabla" id="tablaMantenimientos">

                <thead>
                    <tr>
                        <th data-tipo="numero">N.º</th>
                        <th data-tipo="texto">Equipo</th>
                        <th data-tipo="texto">Código de inventario</th>
                        <th data-tipo="texto">Técnico asignado</th>
                        <th data-tipo="texto">Tipo de mantenimiento</th>
                        <th data-tipo="fecha">Fecha programada</th>
                        <th data-tipo="numero">Duración estimada</th>
                        <th data-tipo="fecha">Finalización estimada</th>
                        <th data-tipo="texto">Estado</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var mantenimiento in Model)
                    {
                        var fechaFinalizacionEstimada = mantenimiento.DuracionEstimadaHoras.HasValue
                            ? mantenimiento.FechaProgramada.AddHours((double)mantenimiento.DuracionEstimadaHoras.Value)
                            : (DateTime?)null;

                        <tr class="cmse-fila-incidencia"
                            data-id="@mantenimiento.IdMantenimiento">

                            <td data-valor="@mantenimiento.IdMantenimiento">@mantenimiento.IdMantenimiento</td>
                            <td>@mantenimiento.IdEquipoNavigation.Nombre</td>
                            <td>@mantenimiento.IdEquipoNavigation.CodigoInventario</td>

                            <td>
                                @mantenimiento.IdTecnicoNavigation.Nombres
                                @mantenimiento.IdTecnicoNavigation.Apellidos
                            </td>

                            <td>@mantenimiento.IdTipoMantenimientoNavigation.Nombre</td>

                            <td data-valor="@mantenimiento.FechaProgramada.ToString("yyyy-MM-dd HH:mm:ss")">
                                @mantenimiento.FechaProgramada.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td data-valor="@(mantenimiento.DuracionEstimadaHoras?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")">
                                @(mantenimiento.DuracionEstimadaHoras.HasValue
                                    ? $"{mantenimiento.DuracionEstimadaHoras.Value:F2} horas"
                                    : "No definida")
                            </td>

                            <td data-valor="@(fechaFinalizacionEstimada?.ToString("yyyy-MM-dd HH:mm:ss") ?? "")">
                                @(fechaFinalizacionEstimada.HasValue
                                    ? fechaFinalizacionEstimada.Value.ToString("dd/MM/yyyy HH:mm")
                                    : "No disponible")
                            </td>

                            <td>@mantenimiento.IdEstadoNavigation.Nombre</td>

                        </tr>
                    }
                </tbody>

            </table>

            <div id="mensajeSinResultados"
                 class="cmse-mantenimiento-vacio"
                 style="display:none;">
                <p>No se encontraron mantenimientos que coincidan con la búsqueda.</p>
            </div>
        }
        else
        {
            <div class="cmse-mantenimiento-vacio">
                <h3>No hay mantenimientos registrados</h3>
                <p>Actualmente no existen mantenimientos para consultar.</p>
            </div>
        }

    </div>

    <div class="text-center mt-4">
        <button type="button"
                id="btnConsultarMantenimiento"
                class="cmse-mantenimiento-boton"
                disabled>
            Consultar mantenimiento
        </button>
    </div>

    <div class="cmse-mantenimiento-regresar">
        <a asp-controller="Home"
           asp-action="Index"
           class="cmse-mantenimiento-cancelar">
            Regresar
        </a>
    </div>

</div>

@if (TempData["Exito"] != null || TempData["Error"] != null)
{
    var esExito = TempData["Exito"] != null;
    var mensaje = esExito ? TempData["Exito"] : TempData["Error"];

    <div class="cmse-modal-overlay" id="modalResultado">
        <div class="cmse-modal">
            <div class="cmse-modal-icon">
                @(esExito ? "✓" : "!")
            </div>

            <h3>
                @(esExito ? "Operación exitosa" : "No fue posible completar la operación")
            </h3>

            <p>@mensaje</p>

            <button type="button"
                    class="cmse-modal-button"
                    onclick="document.getElementById('modalResultado').remove()">
                Aceptar
            </button>
        </div>
    </div>
}

@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function() {

            const tabla = document.getElementById("tablaMantenimientos");
            const cuerpo = tabla?.querySelector("tbody");
            const encabezados = tabla?.querySelectorAll("thead th") ?? [];
            const buscador = document.getElementById("buscarMantenimiento");
            const mensajeSinResultados = document.getElementById("mensajeSinResultados");
            const botonConsultar = document.getElementById("btnConsultarMantenimiento");

            let filas = cuerpo ? Array.from(cuerpo.querySelectorAll("tr")) : [];
            let mantenimientoSeleccionado = null;
            let columnaOrdenada = -1;
            let direccionAscendente = true;

            const rutaConsultar = '@Url.Action("ConsultarMantenimiento", "Mantenimiento")';

            function seleccionarFila(fila) {

                filas.forEach(otraFila => {
                    otraFila.classList.remove("cmse-fila-seleccionada");
                });

                fila.classList.add("cmse-fila-seleccionada");

                mantenimientoSeleccionado = fila.dataset.id;
                botonConsultar.disabled = false;
            }

            filas.forEach(fila => {

                fila.addEventListener("click", function() {
                    seleccionarFila(this);
                });

                fila.addEventListener("dblclick", function() {
                    window.location.href =
                        rutaConsultar + "?id=" + this.dataset.id;
                });

            });

            function aplicarBusqueda() {

                const texto = buscador.value.toLowerCase().trim();
                let visibles = 0;

                filas.forEach(fila => {

                    const coincide = fila.textContent.toLowerCase().includes(texto);

                    fila.style.display = coincide ? "" : "none";

                    if (coincide) {
                        visibles++;
                    } else if (fila.dataset.id === mantenimientoSeleccionado) {
                        fila.classList.remove("cmse-fila-seleccionada");
                        mantenimientoSeleccionado = null;
                        botonConsultar.disabled = true;
                    }

                });

                if (mensajeSinResultados) {
                    mensajeSinResultados.style.display =
                        visibles === 0 ? "block" : "none";
                }
            }

            buscador?.addEventListener("input", aplicarBusqueda);

            function obtenerValor(fila, indice, tipo) {

                const celda = fila.cells[indice];

                if (celda.dataset.valor !== undefined) {
                    return celda.dataset.valor;
                }

                return celda.textContent.trim();
            }

            encabezados.forEach((encabezado, indice) => {

                encabezado.style.cursor = "pointer";
                encabezado.title = "Haz clic para ordenar esta columna";

                encabezado.addEventListener("click", function() {

                    if (columnaOrdenada === indice) {
                        direccionAscendente = !direccionAscendente;
                    } else {
                        columnaOrdenada = indice;
                        direccionAscendente = true;
                    }

                    const tipo = this.dataset.tipo || "texto";

                    filas.sort((a, b) => {

                        let valorA = obtenerValor(a, indice, tipo);
                        let valorB = obtenerValor(b, indice, tipo);

                        let comparacion = 0;

                        if (tipo === "numero") {

                            const numeroA = valorA === "" ? null : Number(valorA);
                            const numeroB = valorB === "" ? null : Number(valorB);

                            if (numeroA === null) return 1;
                            if (numeroB === null) return -1;

                            comparacion = numeroA - numeroB;

                        } else if (tipo === "fecha") {

                            if (!valorA) return 1;
                            if (!valorB) return -1;

                            comparacion = valorA.localeCompare(valorB);

                        } else {

                            comparacion = valorA.localeCompare(
                                valorB,
                                "es",
                                { sensitivity: "base", numeric: true }
                            );

                        }

                        return direccionAscendente ? comparacion : -comparacion;

                    });

                    filas.forEach(fila => cuerpo.appendChild(fila));

                    encabezados.forEach(th => {
                        th.removeAttribute("aria-sort");
                        th.textContent = th.textContent.replace(/ [▲▼]$/, "");
                    });

                    this.setAttribute(
                        "aria-sort",
                        direccionAscendente ? "ascending" : "descending"
                    );

                    this.textContent += direccionAscendente ? " ▲" : " ▼";

                    aplicarBusqueda();

                });

            });

            botonConsultar?.addEventListener("click", function() {

                if (mantenimientoSeleccionado) {
                    window.location.href =
                        rutaConsultar + "?id=" + mantenimientoSeleccionado;
                }

            });

            document.addEventListener("keydown", function(event) {

                if (event.ctrlKey || event.altKey || event.metaKey || event.repeat) {
                    return;
                }

                const elemento = event.target;

                if (elemento.tagName === "INPUT" ||
                    elemento.tagName === "TEXTAREA" ||
                    elemento.tagName === "SELECT" ||
                    elemento.isContentEditable) {
                    return;
                }

                switch (event.key.toLowerCase()) {

                    case "m":
                        if (mantenimientoSeleccionado) {
                            event.preventDefault();
                            window.location.href =
                                rutaConsultar + "?id=" + mantenimientoSeleccionado;
                        }
                        break;

                    case "a":
                        event.preventDefault();
                        window.location.href =
                            '@Url.Action("Index", "Mantenimiento")';
                        break;

                }

            });

        });
    </script>
}
