@model cmse.Repositories.Models.Usuario

@{
    ViewData["Title"] = "Detalles del usuario";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>Detalles del usuario</h2>
            <p class="text-muted">
                Información de la cuenta seleccionada.
            </p>
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            <dl class="row">
                <dt class="col-sm-4">ID de usuario</dt>
                <dd class="col-sm-8">@Model.IdUsuario</dd>

                <dt class="col-sm-4">Rol</dt>
                <dd class="col-sm-8">
                    @Model.IdRolNavigation?.Nombre
                </dd>

                <dt class="col-sm-4">Nombres</dt>
                <dd class="col-sm-8">@Model.Nombres</dd>

                <dt class="col-sm-4">Apellidos</dt>
                <dd class="col-sm-8">@Model.Apellidos</dd>

                <dt class="col-sm-4">Tipo de documento</dt>
                <dd class="col-sm-8">
                    @Model.IdTipoDocumentoNavigation?.Nombre
                </dd>

                <dt class="col-sm-4">Número de documento</dt>
                <dd class="col-sm-8">@Model.NumeroDocumento</dd>

                <dt class="col-sm-4">Correo electrónico</dt>
                <dd class="col-sm-8">@Model.Correo</dd>

                <dt class="col-sm-4">Teléfono</dt>
                <dd class="col-sm-8">
                    @(string.IsNullOrWhiteSpace(Model.Telefono)
                        ? "No registrado"
                        : Model.Telefono)
                </dd>

                <dt class="col-sm-4">Estado de la cuenta</dt>
                <dd class="col-sm-8">
                    @if (Model.Estado)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactivo</span>
                    }
                </dd>
            </dl>

            <hr />

            <div class="d-flex gap-2">
                <a asp-action="Edit"
                   asp-route-id="@Model.IdUsuario"
                   class="btn btn-warning">
                    Editar usuario
                </a>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Volver al listado
                </a>
            </div>

        </div>
    </div>
</div>
