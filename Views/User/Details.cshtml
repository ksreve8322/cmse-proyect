@model cmse.Repositories.Models.Usuario

@{
    ViewData["Title"] = "Detalles del usuario";
}

<div class="container mt-4">
    <h2>Detalles del usuario</h2>
    <p class="text-muted">Información de la cuenta registrada en CMSE.</p>

    <div class="card shadow-sm mt-3">
        <div class="card-header">
            <h5 class="mb-0">
                @Model.Nombres @Model.Apellidos
            </h5>
        </div>

        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>ID de usuario:</strong>
                    <p>@Model.IdUsuario</p>
                </div>

                <div class="col-md-6">
                    <strong>Rol:</strong>
                    <p>@Model.IdRolNavigation.Nombre</p>
                </div>
            </div>

            <hr />

            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Nombres:</strong>
                    <p>@Model.Nombres</p>
                </div>

                <div class="col-md-6">
                    <strong>Apellidos:</strong>
                    <p>@Model.Apellidos</p>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Tipo de documento:</strong>
                    <p>@Model.IdTipoDocumentoNavigation.Nombre</p>
                </div>

                <div class="col-md-6">
                    <strong>Número de documento:</strong>
                    <p>@Model.NumeroDocumento</p>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Correo electrónico:</strong>
                    <p>@Model.Correo</p>
                </div>

                <div class="col-md-6">
                    <strong>Teléfono:</strong>
                    <p>@(Model.Telefono ?? "No registrado")</p>
                </div>
            </div>

            <hr />

            <div class="mb-3">
                <strong>Estado de la cuenta:</strong>

                @if (Model.Estado)
                {
                    <span class="badge bg-success">Activo</span>
                }
                else
                {
                    <span class="badge bg-danger">Inactivo</span>
                }
            </div>

            <a asp-action="Index" class="btn btn-secondary">
                Volver al listado
            </a>
        </div>
    </div>
</div>
