@model List<cmse.Repositories.Models.Notificacion>

@{
    ViewData["Title"] = "Mis notificaciones";
}

<div class="container mt-4">
    <h2>Mis notificaciones</h2>
    <p class="text-muted">Consulta tus avisos y novedades del sistema.</p>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            No tienes notificaciones por el momento.
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var notificacion in Model)
            {
                <div class="list-group-item @(notificacion.Leida ? "" : "list-group-item-primary")">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <h5 class="mb-1">@notificacion.Titulo</h5>
                            <p class="mb-1">@notificacion.Mensaje</p>
                            <small class="text-muted">
                                @notificacion.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                            </small>

                            @if (!notificacion.Leida)
                            {
                                <span class="badge bg-primary ms-2">Nueva</span>
                            }
                        </div>

                        @if (!notificacion.Leida)
                        {
                            <form asp-controller="Notificacion"
                                  asp-action="MarcarComoLeida"
                                  method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden"
                                       name="id"
                                       value="@notificacion.IdNotificacion" />
                                <button type="submit"
                                        class="btn btn-sm btn-outline-primary">
                                    Marcar como leída
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
