@model List<cmse.Repositories.Models.Notificacion>

@{
    ViewData["Title"] = "Mis notificaciones";

    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    int totalRegistros = ViewBag.TotalRegistros ?? 0;
}

<div class="container mt-4">
    <h2>Mis notificaciones</h2>
    <p class="text-muted">Consulta tus avisos y novedades del sistema.</p>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            No tienes notificaciones por el momento.
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var notificacion in Model)
            {
                <div class="list-group-item @(notificacion.Leida ? "" : "list-group-item-primary")">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <h5 class="mb-1">@notificacion.Titulo</h5>
                            <p class="mb-1">@notificacion.Mensaje</p>

                            <small class="text-muted">
                                @notificacion.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                            </small>

                            @if (!notificacion.Leida)
                            {
                                <span class="badge bg-primary ms-2">Nueva</span>
                            }
                        </div>

                        @if (!notificacion.Leida)
                        {
                            <form asp-controller="Notificacion"
                                  asp-action="MarcarComoLeida"
                                  method="post">
                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@notificacion.IdNotificacion" />

                                <button type="submit"
                                        class="btn btn-sm btn-outline-primary">
                                    Marcar como leída
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="mt-3">
            <p class="text-muted">
                Mostrando @Model.Count de @totalRegistros notificaciones.
            </p>

            @if (totalPaginas > 1)
            {
                <nav aria-label="Paginación de notificaciones">
                    <ul class="pagination justify-content-center">

                        <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="@(paginaActual - 1)">
                                Anterior
                            </a>
                        </li>

                        @for (int i = 1; i <= totalPaginas; i++)
                        {
                            <li class="page-item @(i == paginaActual ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pagina="@i">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="@(paginaActual + 1)">
                                Siguiente
                            </a>
                        </li>

                    </ul>
                </nav>
            }
        </div>
    }
</div>
