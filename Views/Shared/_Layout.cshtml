@using cmse.Repositories
@inject NotificacionRepository NotificacionRepository

@{
    int? idUsuarioSesion = Context.Session.GetInt32("UsuarioId");
    int? rolIdSesion = Context.Session.GetInt32("RolId");

    string nombreUsuario = Context.Session.GetString("UsuarioNombre") ?? "";
    string correoUsuario = Context.Session.GetString("UsuarioCorreo") ?? "";
    string rolUsuario = Context.Session.GetString("RolNombre") ?? "";

    bool sesionActiva = idUsuarioSesion.HasValue;
    bool esAdministrador = sesionActiva && rolIdSesion == 1;
    bool esTecnico = sesionActiva && rolIdSesion == 2;
    bool esUsuario = sesionActiva && rolIdSesion == 3;

    int notificacionesNoLeidas = 0;

    if (sesionActiva)
    {
        notificacionesNoLeidas =
            await NotificacionRepository.ContarNoLeidasAsync(idUsuarioSesion!.Value);
    }

    string inicialUsuario = !string.IsNullOrWhiteSpace(nombreUsuario)
        ? nombreUsuario.Substring(0, 1).ToUpper()
        : "U";

    string? tipoMensaje = TempData["TipoMensaje"]?.ToString();
    string? tituloMensaje = TempData["TituloModal"]?.ToString();

    bool cuentaEliminada = TempData["MensajeExito"] != null;

    string? mensaje = cuentaEliminada
        ? TempData["MensajeExito"]?.ToString()
        : TempData["Mensaje"]?.ToString();

    if (!string.IsNullOrEmpty(mensaje))
    {
        if (string.IsNullOrEmpty(tipoMensaje))
            tipoMensaje = cuentaEliminada ? "Exito" : "Advertencia";

        if (string.IsNullOrEmpty(tituloMensaje))
            tituloMensaje = cuentaEliminada ? "¡Cuenta eliminada!" : "Aviso";
    }

    string claseIcono = (tipoMensaje ?? "").ToLower() switch
    {
        "exito" => "cmse-modal-icon-exito",
        "error" => "cmse-modal-icon-error",
        "advertencia" => "cmse-modal-icon-advertencia",
        _ => "cmse-modal-icon-advertencia"
    };

    string icono = (tipoMensaje ?? "").ToLower() switch
    {
        "exito" => "✓",
        "error" => "✕",
        "advertencia" => "!",
        _ => "!"
    };
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CMSE</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/cmse.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="cmse-navbar">
            <div class="cmse-navbar-container">

                <a class="cmse-navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    <img src="~/images/logocmse.jpeg"
                         alt="Logo CMSE"
                         class="cmse-navbar-logo" />
                </a>

                <button class="cmse-navbar-toggle"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#cmseNavbar"
                        aria-controls="cmseNavbar"
                        aria-expanded="false"
                        aria-label="Abrir menú">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>

                <div class="cmse-navbar-menu" id="cmseNavbar">

                    <ul class="cmse-navbar-links">

                        <li>
                            <a asp-controller="Home" asp-action="Index">
                                Inicio
                            </a>
                        </li>

                        @if (esAdministrador)
                        {
                            <li>
                                <a asp-controller="User" asp-action="Index">
                                    Gestionar usuarios
                                </a>
                            </li>

                            <li>
                                <a asp-controller="Equipment" asp-action="Index">
                                    Gestionar equipos
                                </a>
                            </li>

                            <li>
                                <a asp-controller="Mantenimiento" asp-action="Index">
                                    Asignar mantenimientos
                                </a>
                            </li>

                            <li>
                                <a asp-controller="Mantenimiento" asp-action="Consultar">
                                    Consultar mantenimientos
                                </a>
                            </li>

                            <li>
                                <a asp-controller="Mantenimiento" asp-action="Historial">
                                    Historial de mantenimiento
                                </a>
                            </li>

                            <li>
                                <a asp-controller="Reportes" asp-action="Index">
                                    Reportes
                                </a>
                            </li>
                        }
                        else if (esTecnico)
                        {
                            <li>
                                <a asp-controller="Mantenimiento" asp-action="ConsultarAsignaciones">
                                    Mis asignaciones
                                </a>
                            </li>

                            <li>
                                <a asp-controller="Mantenimiento" asp-action="Historial">
                                    Historial de mantenimiento
                                </a>
                            </li>

                            <li>
                                <a asp-controller="Equipment" asp-action="Index">
                                    Consultar equipos
                                </a>
                            </li>
                            <li>
                                <a asp-controller="Mantenimiento" asp-action="MisMantenimientos">
                                    Mis mantenimientos
                                </a>
                            </li>
                        }
                        else if (esUsuario)
                        {
                            <li>
                                <a asp-controller="Equipment" asp-action="Index">
                                    Consultar equipos
                                </a>
                            </li>

                            <li>
                                <a asp-controller="Incidencia" asp-action="Create">
                                    Registrar incidencia
                                </a>
                            </li>

                            <li>
                                <a asp-controller="Incidencia" asp-action="Index">
                                    Mis incidencias
                                </a>
                            </li>
                        }

                    </ul>

                    <div class="cmse-navbar-account">

                        @if (sesionActiva)
                        {
                            <a class="cmse-notification-button"
                               asp-controller="Notificacion"
                               asp-action="Index"
                               title="Mis notificaciones"
                               aria-label="Mis notificaciones">

                                <span class="cmse-notification-icon">&#128276;</span>

                                @if (notificacionesNoLeidas > 0)
                                {
                                    <span class="cmse-notification-count">
                                        @notificacionesNoLeidas
                                    </span>
                                }
                            </a>

                            <div class="dropdown">
                                <button class="cmse-profile-button"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false"
                                        aria-label="Menú de usuario">

                                    <span class="cmse-profile-avatar">
                                        @inicialUsuario
                                    </span>
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end cmse-profile-dropdown">

                                    <li>
                                        <span class="dropdown-item-text cmse-profile-name">
                                            @nombreUsuario
                                        </span>
                                    </li>

                                    <li>
                                        <span class="dropdown-item-text">
                                            @correoUsuario
                                        </span>
                                    </li>

                                    @if (!string.IsNullOrWhiteSpace(rolUsuario))
                                    {
                                        <li>
                                            <span class="dropdown-item-text">
                                                Rol: @rolUsuario
                                            </span>
                                        </li>
                                    }

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>
                                        <a class="dropdown-item cmse-dropdown-item"
                                           asp-controller="Perfil"
                                           asp-action="Index">
                                            <span class="cmse-dropdown-icon">&#128100;</span>
                                            Mi perfil
                                        </a>
                                    </li>

                                    <li>
                                        <form asp-controller="Account"
                                              asp-action="Logout"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="dropdown-item cmse-dropdown-item cmse-logout-item">
                                                <span class="cmse-dropdown-icon">&#10162;</span>
                                                Cerrar sesión
                                            </button>
                                        </form>
                                    </li>

                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account"
                               asp-action="Login"
                               class="cmse-navbar-login">
                                Iniciar sesión
                            </a>

                            <a asp-controller="Account"
                               asp-action="Register"
                               class="cmse-navbar-register">
                                Registrarse
                            </a>
                        }

                    </div>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - CMSE
        </div>
    </footer>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div id="cmse-modal-overlay" class="cmse-modal-overlay">
            <section class="cmse-modal"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="cmse-modal-title"
                     aria-describedby="cmse-modal-message">

                <div class="cmse-modal-icon @claseIcono" aria-hidden="true">
                    <span>@icono</span>
                </div>

                <h2 id="cmse-modal-title">
                    @tituloMensaje
                </h2>

                <p id="cmse-modal-message">
                    @mensaje
                </p>

                <button type="button"
                        id="cmse-modal-accept"
                        class="cmse-modal-button">
                    Aceptar
                </button>
            </section>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @* Atajos de teclado del módulo de mantenimiento *@
    <script>
        document.addEventListener("keydown", function(event) {

            const rutaActual = window.location.pathname.toLowerCase();

            if (!rutaActual.includes("/mantenimiento")) {
                return;
            }

            if (event.ctrlKey || event.altKey || event.metaKey || event.repeat) {
                return;
            }

            const elemento = event.target;

            if (elemento.tagName === "INPUT" ||
                elemento.tagName === "TEXTAREA" ||
                elemento.tagName === "SELECT" ||
                elemento.isContentEditable) {
                return;
            }

            let destino = null;

            switch (event.key.toLowerCase()) {
                case "i":
                    destino = '@Url.Action("ConsultarAsignaciones", "Mantenimiento")';
                    break;

                case "m":
                    destino = '@Url.Action("Consultar", "Mantenimiento")';
                    break;

                case "p":
                    destino = '@Url.Action("Programar", "Mantenimiento")';
                    break;
            }

            if (destino) {
                event.preventDefault();
                window.location.href = destino;
            }

        }, true);
    </script>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <script>
            (function() {
                const overlay = document.getElementById('cmse-modal-overlay');
                const boton = document.getElementById('cmse-modal-accept');

                if (!overlay || !boton) return;

                boton.focus();

                boton.addEventListener('click', function() {
                    overlay.classList.add('cmse-modal-closing');

                    setTimeout(function() {
                        overlay.remove();
                    }, 180);
                });
            })();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
