<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CMSE</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/cmse.styles.css" asp-append-version="true" />
</head>

<body>

    <header>

        <nav class="cmse-navbar">

            <div class="cmse-navbar-container">

                <!-- Logo -->
                <a class="cmse-navbar-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    <img src="~/images/logocmse.jpeg"
                         alt="Logo CMSE"
                         class="cmse-navbar-logo" />

                </a>

                <!-- Botón para móviles -->
                <button class="cmse-navbar-toggle"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#cmseNavbar"
                        aria-controls="cmseNavbar"
                        aria-expanded="false"
                        aria-label="Abrir menú">

                    <span></span>
                    <span></span>
                    <span></span>

                </button>

                <div class="collapse cmse-navbar-menu" id="cmseNavbar">

                    <!-- Enlaces principales -->
                    <ul class="cmse-navbar-links">

                        <li>
                            <a asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Inicio
                            </a>
                        </li>

                    </ul>

                    <!-- Zona de usuario -->
                    <div class="cmse-navbar-account">

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <a class="cmse-navbar-user"
                               asp-controller="Home"
                               asp-action="Index">

                                <span class="cmse-user-icon">●</span>
                                <span>@User.Identity.Name</span>

                            </a>

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post">

                                <button type="submit"
                                        class="cmse-navbar-logout">
                                    Cerrar sesión
                                </button>

                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account"
                               asp-action="Login"
                               class="cmse-navbar-login">
                                Iniciar sesión
                            </a>

                            <a asp-controller="Account"
                               asp-action="Register"
                               class="cmse-navbar-register">
                                Registrarse
                            </a>
                        }

                    </div>

                </div>

            </div>

        </nav>

    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">

        <div class="container">
            &copy; 2026 - CMSE
        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>