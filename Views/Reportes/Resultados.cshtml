@{
    ViewData["Title"] = "Resultados del reporte";
    var incidencias = ViewBag.Incidencias;
    var mantenimientos = ViewBag.Mantenimientos;
}

<div class="container mt-4 mb-5">

    <h2 class="text-center mb-4">Reporte de mantenimiento e incidencias</h2>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="mb-3">Filtros aplicados</h5>

            <div class="row">
                <div class="col-md-4 mb-2">
                    <strong>Fecha inicial:</strong>
                    @(ViewBag.FechaInicio ?? "Sin límite")
                </div>

                <div class="col-md-4 mb-2">
                    <strong>Fecha final:</strong>
                    @(ViewBag.FechaFin ?? "Sin límite")
                </div>

                <div class="col-md-4 mb-2">
                    <strong>Tipo de equipo:</strong>
                    @(ViewBag.NombreTipoEquipo ?? "Todos")
                </div>

                <div class="col-md-6 mb-2">
                    <strong>Técnico:</strong>
                    @(ViewBag.NombreTecnico ?? "Todos")
                </div>

                <div class="col-md-6 mb-2">
                    <strong>Estado:</strong>
                    @(ViewBag.NombreEstado ?? "Todos")
                </div>
            </div>
        </div>
    </div>

    <h4 class="mb-3">Incidencias registradas</h4>

    <div class="table-responsive mb-5">
        <table class="table table-bordered table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Título</th>
                    <th>Fecha de registro</th>
                    <th>Fecha de cierre</th>
                    <th>Equipo</th>
                    <th>Tipo de equipo</th>
                    <th>Técnicos asignados</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (incidencias != null && incidencias.Count > 0)
                {
                    foreach (var incidencia in incidencias)
                    {
                        <tr>
                            <td>@incidencia.IdIncidencia</td>
                            <td>@incidencia.Titulo</td>
                            <td>@incidencia.FechaRegistro.ToString("dd/MM/yyyy")</td>
                            <td>
                                @(incidencia.FechaCierre?.ToString("dd/MM/yyyy") ?? "Pendiente")
                            </td>
                            <td>@incidencia.Equipo</td>
                            <td>@incidencia.TipoEquipo</td>
                            <td>
                                @(incidencia.Tecnicos.Count > 0
                                    ? string.Join(", ", incidencia.Tecnicos)
                                    : "Sin asignar")
                            </td>
                            <td>@incidencia.Estado</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center">
                            No se encontraron incidencias con los filtros seleccionados.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <h4 class="mb-3">Mantenimientos registrados</h4>

    <div class="table-responsive mb-4">
        <table class="table table-bordered table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Fecha</th>
                    <th>Equipo</th>
                    <th>Tipo de equipo</th>
                    <th>Técnico</th>
                    <th>Tipo de mantenimiento</th>
                    <th>Resultado</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (mantenimientos != null && mantenimientos.Count > 0)
                {
                    foreach (var mantenimiento in mantenimientos)
                    {
                        <tr>
                            <td>@mantenimiento.IdMantenimiento</td>
                            <td>@mantenimiento.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@mantenimiento.Equipo</td>
                            <td>@mantenimiento.TipoEquipo</td>
                            <td>@mantenimiento.Tecnico</td>
                            <td>@mantenimiento.TipoMantenimiento</td>
                            <td>@(mantenimiento.Resultado ?? "Sin resultado")</td>
                            <td>@mantenimiento.Estado</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center">
                            No se encontraron mantenimientos con los filtros seleccionados.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-center gap-3 mt-4">

        <a asp-controller="Reportes"
           asp-action="DescargarPdf"
           asp-route-fechaInicio="@ViewBag.FechaInicio"
           asp-route-fechaFin="@ViewBag.FechaFin"
           asp-route-idTipoEquipo="@ViewBag.IdTipoEquipo"
           asp-route-idTecnico="@ViewBag.IdTecnico"
           asp-route-idEstado="@ViewBag.IdEstado"
           class="btn btn-primary">
            <i class="bi bi-file-earmark-pdf"></i>
            Descargar PDF
        </a>

        <a asp-controller="Reportes"
           asp-action="Index"
           class="btn btn-secondary">
            Regresar a filtros
        </a>

    </div>

</div>
