@{
    ViewData["Title"] = "Reportes de mantenimiento e incidencias";
}

<div class="container mt-4">
    <h2 class="text-center mb-4">Reportes de mantenimiento e incidencias</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-controller="Reportes" asp-action="Generar" method="get">

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label for="fechaInicio" class="form-label">Fecha inicial</label>
                        <input type="date" id="fechaInicio" name="fechaInicio"
                               class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label for="fechaFin" class="form-label">Fecha final</label>
                        <input type="date" id="fechaFin" name="fechaFin"
                               class="form-control" />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label for="idTipoEquipo" class="form-label">Tipo de equipo</label>
                        <select id="idTipoEquipo" name="idTipoEquipo" class="form-select">
                            <option value="">Todos los tipos</option>
                            @foreach (var tipo in ViewBag.TiposEquipo)
                            {
                                <option value="@tipo.IdTipoEquipo">@tipo.Nombre</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label for="idTecnico" class="form-label">Técnico</label>
                        <select id="idTecnico" name="idTecnico" class="form-select">
                            <option value="">Todos los técnicos</option>
                            @foreach (var tecnico in ViewBag.Tecnicos)
                            {
                                <option value="@tecnico.IdUsuario">
                                    @tecnico.Nombres @tecnico.Apellidos
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <div class="mb-4">
                    <label for="idEstado" class="form-label">Estado</label>
                    <select id="idEstado" name="idEstado" class="form-select">
                        <option value="">Todos los estados</option>
                        @foreach (var estado in ViewBag.Estados)
                        {
                            <option value="@estado.IdEstado">@estado.Nombre</option>
                        }
                    </select>
                </div>

                <div class="d-flex justify-content-center gap-3">
                    <button type="submit" class="btn btn-primary">
                        Generar reporte
                    </button>

                    <a asp-controller="Home" asp-action="Index"
                       class="btn btn-secondary">
                        Regresar
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>
