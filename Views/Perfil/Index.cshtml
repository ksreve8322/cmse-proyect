@model cmse.Repositories.Models.Usuario

@{
    ViewData["Title"] = "Mi perfil";

    string nombreCompleto = $"{Model.Nombres} {Model.Apellidos}";
    string inicial = !string.IsNullOrWhiteSpace(Model.Nombres)
        ? Model.Nombres.Substring(0, 1).ToUpper()
        : "U";
}

<div class="container py-4">
    <div class="mb-4">
        <h2 class="fw-bold">Mi perfil</h2>
        <p class="text-muted">
            Consulta la información de tu cuenta en CMSE.
        </p>
    </div>

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["MensajeError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary text-white d-flex
                    align-items-center justify-content-center"
                     style="width: 70px; height: 70px; font-size: 28px;">
                    @inicial
                </div>

                <div>
                    <h4 class="fw-bold mb-1">@nombreCompleto</h4>
                    <p class="text-muted mb-1">@Model.Correo</p>
                    <span class="badge bg-primary">
                        @(Model.IdRolNavigation?.Nombre ?? "Usuario")
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">Información personal</h5>
        </div>

        <div class="card-body p-4">
            <div class="row g-4">
                <div class="col-md-6">
                    <small class="text-muted">Nombres</small>
                    <p class="fw-semibold mb-0">@Model.Nombres</p>
                </div>

                <div class="col-md-6">
                    <small class="text-muted">Apellidos</small>
                    <p class="fw-semibold mb-0">@Model.Apellidos</p>
                </div>

                <div class="col-md-6">
                    <small class="text-muted">Tipo de documento</small>
                    <p class="fw-semibold mb-0">
                        @(Model.IdTipoDocumentoNavigation?.Nombre ?? "No disponible")
                    </p>
                </div>

                <div class="col-md-6">
                    <small class="text-muted">Número de documento</small>
                    <p class="fw-semibold mb-0">@Model.NumeroDocumento</p>
                </div>

                <div class="col-md-6">
                    <small class="text-muted">Correo electrónico</small>
                    <p class="fw-semibold mb-0">@Model.Correo</p>
                </div>

                <div class="col-md-6">
                    <small class="text-muted">Teléfono</small>
                    <p class="fw-semibold mb-0">
                        @(string.IsNullOrWhiteSpace(Model.Telefono)
                            ? "No registrado"
                            : Model.Telefono)
                    </p>
                </div>

                <div class="col-md-6">
                    <small class="text-muted">Estado de la cuenta</small>
                    <p class="mb-0">
                        @if (Model.Estado)
                        {
                            <span class="badge bg-success">Activa</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactiva</span>
                        }
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm border-start border-danger border-4">
        <div class="card-body p-4">
            <h5 class="fw-bold text-danger">Zona de seguridad</h5>

            <p class="text-muted">
                Puedes eliminar permanentemente tu cuenta de CMSE.
                Esta acción no se puede deshacer y requiere confirmar
                tu contraseña actual.
            </p>

            <button type="button"
                    class="btn btn-outline-danger"
                    data-bs-toggle="modal"
                    data-bs-target="#modalEliminarCuenta">
                <i class="bi bi-trash me-1"></i>
                Eliminar mi cuenta
            </button>
        </div>
    </div>
</div>

<!-- Modal de confirmación de eliminación -->
<div class="modal fade"
     id="modalEliminarCuenta"
     tabindex="-1"
     aria-labelledby="modalEliminarCuentaLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">

            <div class="modal-header">
                <h5 class="modal-title fw-bold text-danger"
                    id="modalEliminarCuentaLabel">
                    Eliminar mi cuenta
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>
            </div>

            <form asp-controller="Perfil"
                  asp-action="EliminarCuenta"
                  method="post">

                <div class="modal-body">

                    <div class="text-center mb-3">
                        <i class="bi bi-exclamation-triangle-fill text-danger"
                           style="font-size: 45px;"></i>
                    </div>

                    <p class="text-center fw-semibold">
                        ¿Estás seguro de que deseas eliminar tu cuenta?
                    </p>

                    <div class="alert alert-warning">
                        <strong>Advertencia:</strong>
                        Esta acción es permanente. Se eliminarán los datos
                        auxiliares de tu cuenta y se cerrará tu sesión.
                        Los registros operativos asociados impedirán
                        la eliminación para proteger el historial del sistema.
                    </div>

                    <div class="mb-3">
                        <label for="contrasenaActual" class="form-label fw-semibold">
                            Confirma tu contraseña actual
                        </label>

                        <input type="password"
                               class="form-control"
                               id="contrasenaActual"
                               name="contrasenaActual"
                               placeholder="Ingresa tu contraseña"
                               required
                               autocomplete="current-password" />
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        No, cancelar
                    </button>

                    <button type="submit" class="btn btn-danger">
                        Sí, eliminar mi cuenta
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>
