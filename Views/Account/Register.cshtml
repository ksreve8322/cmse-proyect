@model cmse.Dtos.RegistroDto

@{
    ViewData["Title"] = "Crear Cuenta";
}

<div class="cmse-register-page">

    @* Enlace fuera del recuadro principal *@
    <a asp-controller="Home" asp-action="Index" class="cmse-register-back">
        ← Volver
    </a>

    <div class="cmse-register-container">

        <header class="cmse-register-heading">
            <h1>Crear Cuenta</h1>
            <p>Control y Mantenimiento de<br />Sistemas y Equipos</p>
        </header>

        <form asp-action="Register" method="post" class="cmse-register-form">

            @* Columna izquierda *@
            <div class="cmse-register-fields cmse-register-left">

                <div class="cmse-form-group">
                    <label asp-for="Nombres">Nombres</label>
                    <input asp-for="Nombres" placeholder="Ingresa tus nombres" />
                    <span asp-validation-for="Nombres"></span>
                </div>

                <div class="cmse-form-group">
                    <label asp-for="Apellidos">Apellidos</label>
                    <input asp-for="Apellidos" placeholder="Ingresa tus apellidos" />
                    <span asp-validation-for="Apellidos"></span>
                </div>

                <div class="cmse-form-group">
                    <label asp-for="NumeroDocumento">Número de documento</label>
                    <input asp-for="NumeroDocumento" placeholder="Ingresa tu documento" />
                    <span asp-validation-for="NumeroDocumento"></span>
                </div>

                <div class="cmse-form-group">
                    <label asp-for="IdTipoDocumento">Tipo de documento</label>
                    <select asp-for="IdTipoDocumento">
                        <option value="">Seleccione un tipo</option>
                        @foreach (var tipo in ViewBag.TiposDocumento)
                        {
                            <option value="@tipo.IdTipoDocumento">
                                @tipo.Nombre
                            </option>
                        }
                    </select>
                    <span asp-validation-for="IdTipoDocumento"></span>
                </div>

            </div>

            @* Logo central *@
            <div class="cmse-register-logo">
                <img src="~/images/logocmse.jpeg" alt="Logo CMSE" />
            </div>

            @* Columna derecha *@
            <div class="cmse-register-fields cmse-register-right">

                <div class="cmse-form-group">
                    <label asp-for="Correo">Correo electrónico</label>
                    <input asp-for="Correo" type="email" placeholder="Ingresa tu correo" />
                    <span asp-validation-for="Correo"></span>
                </div>

                <div class="cmse-form-group">
                    <label asp-for="Telefono">Teléfono</label>
                    <input asp-for="Telefono" placeholder="Ingresa tu teléfono" />
                    <span asp-validation-for="Telefono"></span>
                </div>

                <div class="cmse-form-group">
                    <label asp-for="Contrasena">Contraseña</label>
                    <input asp-for="Contrasena" type="password" placeholder="Crea una contraseña" />
                    <span asp-validation-for="Contrasena"></span>
                </div>

            </div>

            @* Mensajes de validación *@
            <div asp-validation-summary="ModelOnly" class="cmse-validation cmse-register-validation"></div>

            @* Botones *@
            <div class="cmse-register-actions">
                <button type="submit" class="cmse-auth-button">
                    Registrar
                </button>

                <a asp-controller="Home" asp-action="Index" class="cmse-register-cancel">
                    Cancelar
                </a>
            </div>

        </form>

        @* Acceso para usuarios que ya tienen cuenta *@
        <div class="cmse-register-login">
            <span>¿Ya tienes una cuenta?</span>
            <a asp-controller="Account" asp-action="Login">Iniciar sesión</a>
        </div>

    </div>
</div>
