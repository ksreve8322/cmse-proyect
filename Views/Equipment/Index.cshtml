@using cmse.Repositories.Models
@model IEnumerable<Equipo>

@{
    ViewData["Title"] = "Equipos registrados";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1>Equipos registrados</h1>
            <p class="text-muted mb-0">
                Consulta los equipos del inventario de CMSE.
            </p>
        </div>

        <a asp-controller="Equipment"
           asp-action="Create"
           class="btn btn-primary">
            + Registrar equipo
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["Mensaje"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            Todavía no hay equipos registrados.
            Usa el botón «Registrar equipo» para agregar el primero.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Nombre</th>
                        <th>Código</th>
                        <th>Tipo</th>
                        <th>Estado</th>
                        <th>Marca</th>
                        <th>Ubicación</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var equipo in Model)
                    {
                        <tr>
                            <td>@equipo.Nombre</td>
                            <td>@equipo.CodigoInventario</td>
                            <td>@equipo.IdTipoEquipoNavigation?.Nombre</td>
                            <td>@equipo.IdEstadoNavigation?.Nombre</td>
                            <td>@equipo.Marca</td>
                            <td>@equipo.Ubicacion</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <p class="text-muted">
            Total de equipos: @Model.Count()
        </p>
    }
</div>
