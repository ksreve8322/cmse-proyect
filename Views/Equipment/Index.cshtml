@using cmse.Repositories.Models
@model IEnumerable<Equipo>

@{
    ViewData["Title"] = "Consultar equipos";

    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    int totalRegistros = ViewBag.TotalRegistros ?? 0;

    int? rolId = Context.Session.GetInt32("RolId");
    bool esAdministrador = rolId == 1;
}

<div class="cmse-mantenimiento-container">

    <!-- ENCABEZADO -->
    <div class="cmse-mantenimiento-header">
        <h2>
            @(esAdministrador ? "Gestionar equipos" : "Consultar equipos")
        </h2>

        <p>
            @(esAdministrador
                ? "Administración de equipos registrados en CMSE."
                : "Consulta los equipos registrados y su información en CMSE.")
        </p>
    </div>

    <!-- MENSAJES -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success text-center">
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger text-center">
            @TempData["Error"]
        </div>
    }

    <div id="avisoSeleccion" class="alert alert-warning text-center d-none">
        Selecciona un equipo de la tabla para continuar.
    </div>

    <!-- PANEL PRINCIPAL -->
    <div class="cmse-mantenimiento-panel">

        <!-- BÚSQUEDA -->
        <div class="cmse-mantenimiento-barra-superior">

            <div class="cmse-mantenimiento-busqueda">
                <span class="cmse-mantenimiento-lupa" aria-hidden="true">⌕</span>

                <input type="search"
                       id="buscarEquipo"
                       placeholder="Buscar equipo..."
                       autocomplete="off"
                       aria-label="Buscar equipo por tipo, modelo, marca o número de serie" />
            </div>

        </div>

        <!-- BOTONES DE ACCIONES -->
        <div class="cmse-mantenimiento-acciones justify-content-center">

            <button type="button"
                    class="cmse-mantenimiento-boton"
                    onclick="consultarEquipo()"
                    title="Atajo: C">
                Consultar
            </button>

            @if (esAdministrador)
            {
                <button type="button"
                        class="cmse-mantenimiento-boton"
                        onclick="actualizarEquipo()"
                        title="Atajo: A">
                    Actualizar
                </button>

                <a asp-action="Create"
                   class="cmse-mantenimiento-boton text-decoration-none"
                   title="Atajo: R">
                    Registrar
                </a>

                <button type="button"
                        class="cmse-mantenimiento-boton"
                        onclick="eliminarEquipo()"
                        title="Atajo: E">
                    Eliminar
                </button>
            }

        </div>

        <!-- TABLA -->
        @if (Model == null || !Model.Any())
        {
            <div class="cmse-mantenimiento-vacio">
                <h3>No hay equipos registrados</h3>
                <p>No se encontraron equipos para mostrar.</p>
            </div>
        }
        else
        {
            <div class="cmse-mantenimiento-tabla-contenedor">

                <table class="cmse-mantenimiento-tabla"
                       id="tablaEquipos">

                    <thead>
                        <tr>
                            <th>Tipo</th>
                            <th>Modelo</th>
                            <th>Marca</th>
                            <th>Número de serie</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var equipo in Model)
                        {
                            <tr class="fila-equipo"
                                data-id="@equipo.IdEquipo"
                                onclick="seleccionarEquipo(this)"
                                ondblclick="consultarEquipo()">

                                <td>
                                    @equipo.IdTipoEquipoNavigation?.Nombre
                                </td>

                                <td>
                                    @(equipo.Modelo ?? "No especificado")
                                </td>

                                <td>
                                    @(equipo.Marca ?? "No especificada")
                                </td>

                                <td>
                                    @(equipo.NumeroSerie ?? "No especificado")
                                </td>

                            </tr>
                        }
                    </tbody>

                </table>

                <div id="sinResultadosBusqueda"
                     class="cmse-mantenimiento-vacio d-none">
                    <p>No se encontraron equipos que coincidan con la búsqueda.</p>
                </div>

            </div>

            <!-- PAGINACIÓN -->
            <div class="cmse-equipos-paginacion">

                <span class="text-muted">
                    Total: @totalRegistros |
                    Página @paginaActual de @totalPaginas
                </span>

                @if (totalPaginas > 1)
                {
                    <nav aria-label="Paginación de equipos">
                        <ul class="pagination mb-0">

                            <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pagina="@(paginaActual - 1)">
                                    Anterior
                                </a>
                            </li>

                            @for (int i = 1; i <= totalPaginas; i++)
                            {
                                <li class="page-item @(i == paginaActual ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-pagina="@i"
                                       aria-current="@(i == paginaActual ? "page" : null)">
                                        @i
                                    </a>
                                </li>
                            }

                            <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pagina="@(paginaActual + 1)">
                                    Siguiente
                                </a>
                            </li>

                        </ul>
                    </nav>
                }

            </div>
        }

    </div>

    <!-- REGRESAR -->
    <div class="text-center mt-4">
        <a asp-controller="Home"
           asp-action="Index"
           class="cmse-mantenimiento-cancelar text-decoration-none">
            Regresar
        </a>
    </div>

</div>

<style>
    .fila-equipo {
        cursor: pointer;
        transition: background-color 0.15s ease;
    }

        .fila-equipo:hover {
            background-color: #e9f2ff !important;
        }

        .fila-equipo.seleccionado {
            background-color: #cfe2ff !important;
            outline: 2px solid #0d6efd;
            outline-offset: -2px;
        }

    .cmse-equipos-paginacion {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-top: 20px;
    }

        .cmse-equipos-paginacion .pagination {
            flex-wrap: wrap;
        }

    @@media (max-width: 576px) {
        .cmse-equipos-paginacion {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<script>
    let equipoSeleccionado = null;
    const esAdministrador = @(esAdministrador ? "true" : "false");

    // SELECCIONAR EQUIPO
    function seleccionarEquipo(fila) {
        document.querySelectorAll(".fila-equipo").forEach(function(elemento) {
            elemento.classList.remove("seleccionado");
        });

        fila.classList.add("seleccionado");
        equipoSeleccionado = fila.dataset.id;

        document.getElementById("avisoSeleccion").classList.add("d-none");
    }

    // VALIDAR SELECCIÓN
    function validarSeleccion() {
        if (!equipoSeleccionado) {
            document.getElementById("avisoSeleccion").classList.remove("d-none");
            return false;
        }

        return true;
    }

    // CONSULTAR
    function consultarEquipo() {
        if (!validarSeleccion()) return;

        window.location.href = "/Equipment/Details/" + equipoSeleccionado;
    }

    // ACTUALIZAR
    function actualizarEquipo() {
        if (!esAdministrador || !validarSeleccion()) return;

        window.location.href = "/Equipment/Editar/" + equipoSeleccionado;
    }

    // ELIMINAR
    function eliminarEquipo() {
        if (!esAdministrador || !validarSeleccion()) return;

        window.location.href = "/Equipment/Eliminar/" + equipoSeleccionado;
    }

    // BÚSQUEDA
    document.getElementById("buscarEquipo").addEventListener("input", function() {
        const busqueda = this.value.trim().toLowerCase();
        const filas = document.querySelectorAll(".fila-equipo");
        let resultados = 0;

        filas.forEach(function(fila) {
            const coincide = fila.textContent.toLowerCase().includes(busqueda);

            fila.style.display = coincide ? "" : "none";

            if (coincide) {
                resultados++;
            } else {
                fila.classList.remove("seleccionado");

                if (equipoSeleccionado === fila.dataset.id) {
                    equipoSeleccionado = null;
                }
            }
        });

        document.getElementById("sinResultadosBusqueda")
            .classList.toggle("d-none", resultados !== 0);

        if (equipoSeleccionado === null) {
            document.getElementById("avisoSeleccion").classList.add("d-none");
        }
    });

    // ATAJOS DE TECLADO
    document.addEventListener("keydown", function(event) {

        const elemento = event.target;
        const etiqueta = elemento.tagName.toLowerCase();

        if (
            etiqueta === "input" ||
            etiqueta === "textarea" ||
            etiqueta === "select" ||
            elemento.isContentEditable ||
            event.ctrlKey ||
            event.altKey ||
            event.metaKey ||
            event.shiftKey
        ) {
            return;
        }

        switch (event.key.toLowerCase()) {
            case "c":
                event.preventDefault();
                consultarEquipo();
                break;

            @if (esAdministrador)
            {
                <text>
                case "a":
                    event.preventDefault();
                    actualizarEquipo();
                    break;

                case "r":
                    event.preventDefault();
                    window.location.href = '@Url.Action("Create", "Equipment")';
                    break;

                case "e":
                    event.preventDefault();
                    eliminarEquipo();
                    break;
                </text>
            }
        }
    });
</script>
