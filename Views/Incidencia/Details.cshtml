
@model cmse.Repositories.Models.Incidencia

@{
    ViewData["Title"] = "Detalle de incidencia";
}

<div class="container mt-4 mb-5">
    <h2>Detalle de incidencia</h2>
    <hr />

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <h4>@Model.Titulo</h4>
            <p class="text-muted">
                Incidencia #@Model.IdIncidencia
            </p>

            <hr />

            <p>
                <strong>Descripción:</strong><br />
                @Model.Descripcion
            </p>

            <p>
                <strong>Equipo:</strong>
                @Model.IdEquipoNavigation?.Nombre
            </p>

            <p>
                <strong>Estado:</strong>
                @Model.IdEstadoNavigation?.Nombre
            </p>

            <p>
                <strong>Fecha de registro:</strong>
                @Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")
            </p>

            <p>
                <strong>Fecha de cierre:</strong>
                @(Model.FechaCierre.HasValue
                    ? Model.FechaCierre.Value.ToString("dd/MM/yyyy HH:mm")
                    : "Pendiente")
            </p>

            <hr />

            <h5 class="mb-3">Archivos adjuntos</h5>

            @if (Model.ArchivosIncidencia != null &&
                 Model.ArchivosIncidencia.Any())
            {
                <div class="list-group mb-4">
                    @foreach (var archivo in Model.ArchivosIncidencia)
                    {
                        <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">

                            <div>
                                <strong>@archivo.NombreArchivo</strong>
                                <br />
                                <small class="text-muted">
                                    @archivo.Extension.ToUpper()
                                    ·
                                    @archivo.FechaSubida.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>

                            <div class="d-flex gap-2">
                                <a href="@Url.Content(archivo.RutaArchivo)"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="btn btn-outline-primary btn-sm">
                                    Abrir
                                </a>

                                <a href="@Url.Content(archivo.RutaArchivo)"
                                   download="@archivo.NombreArchivo"
                                   class="btn btn-primary btn-sm">
                                    Descargar
                                </a>
                            </div>

                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted mb-4">
                    Esta incidencia no tiene archivos adjuntos.
                </p>
            }

            <hr />

            <a asp-controller="Incidencia"
               asp-action="Index"
               class="btn btn-secondary">
                Volver a incidencias
            </a>

        </div>
    </div>
</div>
