@{
    ViewData["Title"] = "Registrar incidencia";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5">

                    <div class="mb-4">
                        <h2 class="mb-2">Registrar incidencia</h2>
                        <p class="text-muted">
                            Describe el problema, selecciona el equipo afectado
                            y adjunta evidencias si las tienes.
                        </p>
                    </div>

                    <form asp-controller="Incidencia"
                          asp-action="Create"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label for="titulo" class="form-label">
                                Título de la incidencia
                            </label>

                            <input type="text"
                                   id="titulo"
                                   name="titulo"
                                   class="form-control"
                                   maxlength="100"
                                   required
                                   placeholder="Ej. El computador no enciende"
                                   value="@(ViewData.ModelState["titulo"]?.AttemptedValue ?? "")" />
                        </div>

                        <div class="mb-3">
                            <label for="descripcion" class="form-label">
                                Descripción del problema
                            </label>

                            <textarea id="descripcion"
                                      name="descripcion"
                                      class="form-control"
                                      rows="5"
                                      required
                                      placeholder="Explica qué sucede con el equipo...">@(ViewData.ModelState["descripcion"]?.AttemptedValue ?? "")</textarea>
                        </div>

                        <div class="mb-3">
                            <label for="idTipoIncidencia" class="form-label">
                                Tipo de incidencia
                            </label>

                            <select id="idTipoIncidencia"
                                    name="idTipoIncidencia"
                                    class="form-select"
                                    required>

                                <option value="">Selecciona el tipo de incidencia</option>

                                <option value="1"
                                        selected="@(ViewData.ModelState["idTipoIncidencia"]?.AttemptedValue == "1")">
                                    Hardware
                                </option>

                                <option value="2"
                                        selected="@(ViewData.ModelState["idTipoIncidencia"]?.AttemptedValue == "2")">
                                    Software
                                </option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="idEquipo" class="form-label">
                                Equipo afectado
                            </label>

                            <select id="idEquipo"
                                    name="idEquipo"
                                    class="form-select"
                                    required>

                                <option value="">Selecciona un equipo</option>

                                @if (ViewBag.Equipos != null)
                                {
                                    foreach (var equipo in ViewBag.Equipos)
                                    {
                                        <option value="@equipo.IdEquipo"
                                                selected="@(ViewData.ModelState["idEquipo"]?.AttemptedValue == equipo.IdEquipo.ToString())">
                                            @equipo.Nombre — @equipo.CodigoInventario
                                        </option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="archivos" class="form-label">
                                Archivos adjuntos (evidencias)
                            </label>

                            <input type="file"
                                   id="archivos"
                                   name="archivos"
                                   class="form-control"
                                   multiple
                                   accept=".jpg,.jpeg,.png,.pdf,.txt,.xml,.html" />

                            <small class="text-muted">
                                Puedes adjuntar hasta 5 archivos.
                                Formatos permitidos: JPG, JPEG, PNG, PDF, TXT, XML y HTML.
                                Máximo 10 MB por archivo.
                            </small>
                        </div>

                        <div class="mb-4">
                            <label for="estadoInicial" class="form-label">
                                Estado inicial
                            </label>

                            <input type="text"
                                   id="estadoInicial"
                                   class="form-control"
                                   value="Pendiente"
                                   disabled />

                            <small class="text-muted">
                                El sistema asignará automáticamente este estado
                                al registrar la incidencia.
                            </small>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-primary">
                                Registrar incidencia
                            </button>

                            <a asp-controller="Incidencia"
                               asp-action="Index"
                               class="btn btn-outline-primary">
                                Consultar mis incidencias
                            </a>

                            <a asp-controller="Home"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                Volver al inicio
                            </a>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
