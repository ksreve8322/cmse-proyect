@using cmse.Repositories.Models
@model IEnumerable<Incidencia>

@{
    ViewData["Title"] = "Mis incidencias";

    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    int totalRegistros = ViewBag.TotalRegistros ?? 0;
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1>Mis incidencias</h1>
            <p class="text-muted mb-0">
                Consulta y actualiza las incidencias reportadas de tus equipos.
            </p>
        </div>

        <a asp-controller="Incidencia"
           asp-action="Create"
           class="btn btn-primary">
            + Registrar incidencia
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["Mensaje"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            Todavía no has registrado incidencias.
            Usa el botón «Registrar incidencia» para reportar un problema.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Título</th>
                        <th>Equipo</th>
                        <th>Estado</th>
                        <th>Fecha de registro</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var incidencia in Model)
                    {
                        bool estaCerrada =
                            incidencia.IdEstado == 10 ||
                            incidencia.FechaCierre.HasValue ||
                            string.Equals(
                                incidencia.IdEstadoNavigation?.Nombre,
                                "Cerrada",
                                StringComparison.OrdinalIgnoreCase);

                        <tr class="fila-incidencia"
                            data-id="@incidencia.IdIncidencia"
                            data-cerrada="@estaCerrada.ToString().ToLowerInvariant()">

                            <td>@incidencia.Titulo</td>
                            <td>@incidencia.IdEquipoNavigation?.Nombre</td>
                            <td>@incidencia.IdEstadoNavigation?.Nombre</td>
                            <td>@incidencia.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex flex-column align-items-center gap-2 mt-4">

            <div class="d-flex justify-content-center flex-wrap gap-2">

                <button type="button"
                        class="btn btn-primary"
                        id="btnConsultarIncidencia"
                        disabled>
                    Consultar
                </button>

                <button type="button"
                        class="btn btn-primary"
                        id="btnActualizarIncidencia"
                        disabled>
                    Actualizar
                </button>

            </div>

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-secondary">
                Regresar
            </a>

            <small class="text-muted text-center mt-2">
                
            </small>

        </div>

        <script>
            const filas = document.querySelectorAll('.fila-incidencia');

            const botonConsultar = document.getElementById('btnConsultarIncidencia');
            const botonActualizar = document.getElementById('btnActualizarIncidencia');

            let incidenciaSeleccionada = null;
            let incidenciaCerrada = true;

            function consultarIncidencia(id) {
                const urlDetalle = '@Url.Action("Details", "Incidencia", new { id = "__id__" })';
                window.location.href = urlDetalle.replace('__id__', id);
            }

            function actualizarIncidencia(id) {
                const urlEditar = '@Url.Action("Editar", "Incidencia", new { id = "__id__" })';
                window.location.href = urlEditar.replace('__id__', id);
            }

            filas.forEach(fila => {

                fila.addEventListener('click', function() {

                    filas.forEach(f => f.classList.remove('seleccionada'));

                    this.classList.add('seleccionada');

                    incidenciaSeleccionada = this.dataset.id;
                    incidenciaCerrada = this.dataset.cerrada === 'true';

                    botonConsultar.disabled = false;
                    botonActualizar.disabled = incidenciaCerrada;
                });

                fila.addEventListener('dblclick', function() {
                    consultarIncidencia(this.dataset.id);
                });
            });

            botonConsultar.addEventListener('click', function() {
                if (incidenciaSeleccionada) {
                    consultarIncidencia(incidenciaSeleccionada);
                }
            });

            botonActualizar.addEventListener('click', function() {
                if (incidenciaSeleccionada && !incidenciaCerrada) {
                    actualizarIncidencia(incidenciaSeleccionada);
                }
            });

            // Atajos de teclado: C para consultar y A para actualizar.
            document.addEventListener('keydown', function(event) {

                // No ejecutar atajos mientras se escribe en un campo.
                const elemento = event.target;
                const escribiendo =
                    elemento.tagName === 'INPUT' ||
                    elemento.tagName === 'TEXTAREA' ||
                    elemento.tagName === 'SELECT' ||
                    elemento.isContentEditable;

                if (escribiendo || event.ctrlKey || event.altKey ||
                    event.metaKey || event.repeat) {
                    return;
                }

                if (!incidenciaSeleccionada) {
                    return;
                }

                const tecla = event.key.toLowerCase();

                if (tecla === 'c') {
                    event.preventDefault();
                    consultarIncidencia(incidenciaSeleccionada);
                }

                if (tecla === 'a' && !incidenciaCerrada) {
                    event.preventDefault();
                    actualizarIncidencia(incidenciaSeleccionada);
                }
            });
        </script>
    }

    @if (Model != null && Model.Any())
    {
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mt-3">

            <p class="text-muted mb-0">
                Total de incidencias: @totalRegistros
                | Página @paginaActual de @totalPaginas
            </p>

            @if (totalPaginas > 1)
            {
                <nav aria-label="Paginación de incidencias">
                    <ul class="pagination mb-0">

                        <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="@(paginaActual - 1)">
                                Anterior
                            </a>
                        </li>

                        @for (int i = 1; i <= totalPaginas; i++)
                        {
                            <li class="page-item @(i == paginaActual ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pagina="@i">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="@(paginaActual + 1)">
                                Siguiente
                            </a>
                        </li>

                    </ul>
                </nav>
            }

        </div>
    }

</div>
