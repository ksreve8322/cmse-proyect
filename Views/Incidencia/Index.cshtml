@using cmse.Repositories.Models
@model IEnumerable<Incidencia>

@{
    ViewData["Title"] = "Mis incidencias";

    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    int totalRegistros = ViewBag.TotalRegistros ?? 0;
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1>Mis incidencias</h1>
            <p class="text-muted mb-0">
                Consulta las incidencias reportadas de tus equipos.
            </p>
        </div>

        <a asp-controller="Incidencia"
           asp-action="Create"
           class="btn btn-primary">
            + Registrar incidencia
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["Mensaje"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            Todavía no has registrado incidencias.
            Usa el botón «Registrar incidencia» para reportar un problema.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Título</th>
                        <th>Equipo</th>
                        <th>Estado</th>
                        <th>Fecha de registro</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var incidencia in Model)
                    {
                        <tr>
                            <td>@incidencia.Titulo</td>
                            <td>@incidencia.IdEquipoNavigation?.Nombre</td>
                            <td>@incidencia.IdEstadoNavigation?.Nombre</td>
                            <td>@incidencia.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <a asp-controller="Incidencia"
                                   asp-action="Details"
                                   asp-route-id="@incidencia.IdIncidencia"
                                   class="btn btn-sm btn-outline-primary">
                                    Ver detalles
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mt-3">
            <p class="text-muted mb-0">
                Total de incidencias: @totalRegistros
                | Página @paginaActual de @totalPaginas
            </p>

            @if (totalPaginas > 1)
            {
                <nav aria-label="Paginación de incidencias">
                    <ul class="pagination mb-0">

                        <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="@(paginaActual - 1)">
                                Anterior
                            </a>
                        </li>

                        @for (int i = 1; i <= totalPaginas; i++)
                        {
                            <li class="page-item @(i == paginaActual ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pagina="@i">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="@(paginaActual + 1)">
                                Siguiente
                            </a>
                        </li>

                    </ul>
                </nav>
            }
        </div>
    }
</div>
